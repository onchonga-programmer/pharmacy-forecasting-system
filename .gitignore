# ============================================================================
# DATA FILES (IMPORTANT - Keep sensitive data out of Git!)
# ============================================================================

# Raw data files
data/raw/*.csv
data/raw/*.xlsx
data/raw/*.xls
data/raw/*.json
data/raw/*.txt

# Processed data files
data/processed/*.csv
data/processed/*.xlsx
data/processed/*.pkl
data/processed/*.parquet

# Forecast outputs
data/forecasts/*.csv
data/forecasts/*.json

# Results
data/results/*.csv
data/results/*.xlsx

# Large data files
*.csv
*.xlsx
*.xls
*.dat

# Exception: Keep sample/template data
!data/sample_data.csv
!data/template.xlsx
!data/raw/README.md
!data/processed/README.md

# ============================================================================
# MACHINE LEARNING MODELS
# ============================================================================

# Trained models (usually too large for Git)
models/saved_models/*.pkl
models/saved_models/*.h5
models/saved_models/*.pt
models/saved_models/*.pth
models/saved_models/*.onnx
models/saved_models/*.joblib

# Model checkpoints
models/checkpoints/*.h5
models/checkpoints/*.pt
models/checkpoints/*.pth

# TensorFlow/Keras
*.h5
*.hdf5
*.pb

# PyTorch
*.pt
*.pth

# Scikit-learn / Joblib
*.pkl
*.joblib

# XGBoost
*.model
*.bst

# Exception: Keep model architecture files (not weights)
!models/architectures/

# ============================================================================
# DATABASE
# ============================================================================

# SQLite databases
*.db
*.sqlite
*.sqlite3

# PostgreSQL
*.sql.gz

# Database backups (can be large)
database/backups/*.sql
database/backups/*.dump
database/backups/*.backup

# Database connection strings (sensitive!)
database_config.ini
db_credentials.json

# Exception: Keep schema and sample data
!database/schema.sql
!database/sample_data.sql

# ============================================================================
# LOGS
